# --------------------------------------------------------------------
# SIMRAN — Sistem Monitoring Realisasi Anggaran & IKPA
# Environment Configuration Template
# --------------------------------------------------------------------

# Environment mode: production, development, or testing
CI_ENVIRONMENT = production

# Application URL (optional - auto-detected if left empty)
# app.baseURL = 'http://localhost/realisasi'
app.indexPage = ''
app.defaultLocale = id
app.appTimezone = Asia/Jakarta

# Database Configuration (SQLite3 by default)
database.default.DBDriver = SQLite3
database.default.database = WRITEPATH . 'database/simran.sqlite'

# Session Configuration
session.driver = CodeIgniter\Session\Handlers\FileHandler
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = false

# Logging (0 = Disables, 1 = Error, 2 = Debug, 3 = Info, 4 = All)
logger.threshold = 4
